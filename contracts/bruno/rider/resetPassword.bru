meta {
  name: resetPassword
  type: http
  seq: 28
}

post {
  url: {{baseUrl}}/auth/password/reset
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  X-Mock-Scenario: {{scenario}}
  Idempotency-Key: bruno-resetPassword-0001
}

body:json {
  {
    "new_password": "mock_value",
    "otp": "123456",
    "request_id": "mock_value"
  }
}
