meta {
  name: locationPing
  type: http
  seq: 21
}

post {
  url: {{baseUrl}}/riders/me/location
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  X-Mock-Scenario: {{scenario}}
  Idempotency-Key: bruno-locationPing-0001
}

body:json {
  {
    "accuracy_m": 1.5,
    "device_time": "2026-11-04T10:00:00Z",
    "lat": 1.5,
    "lng": 1.5,
    "speed_mps": 1.5
  }
}
