meta {
  name: changePassword
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/me/password
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  X-Mock-Scenario: {{scenario}}
  Idempotency-Key: bruno-changePassword-0001
}

body:json {
  {
    "current_password": "mock_value",
    "new_password": "a-new-long-password"
  }
}
