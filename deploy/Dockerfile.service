# The image for every service: the mock server, customer-api and rider-api.
# Build from the repo root:
#   docker build -f deploy/Dockerfile.service --build-arg SERVICE=apps/customer-api -t customer-api .
FROM golang:1.27-alpine AS build
ARG SERVICE
WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/service "./${SERVICE}"

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/service /service
EXPOSE 8080
ENTRYPOINT ["/service"]
