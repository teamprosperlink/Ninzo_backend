# Copy to .env for local work: cp env.example .env
# Never commit .env. Never paste real secrets into chat or Issues.
# Order timer values (timer length, zone radius and so on) are NOT here. They are console settings stored in the database.

# --- App ---
APP_ENV=local                 # local | staging | production
LOG_LEVEL=debug
HTTP_PORT=8080                # task run:rider uses 8081

# --- Postgres ---
# Local: Docker Postgres from deploy/compose.yml. Staging and production: Supabase session pooler string from the dashboard.
# Services on staging and production must sign in as ninzo_service, and refuse to start otherwise.
# Migrations use the postgres login.
DATABASE_URL=postgres://ninzo:ninzo_local@localhost:5432/ninzo?sslmode=disable
DB_MAX_CONNS=5                # Keep small: all services together must stay under the plan's connection limit

# --- Redis ---
REDIS_URL=redis://localhost:6380/0

# --- Auth ---
JWT_SIGNING_KEY=              # At least 32 characters, random, and different per environment. Replacing it only makes apps refresh
JWT_ACCESS_TTL_SECONDS=900
# The header the hosting proxy sets to the caller's address. Required outside local, or every
# caller would share one rate limit.
# On Railway use X-Real-IP, and confirm on staging that a client cannot forge it. Not X-Forwarded-For.
CLIENT_IP_HEADER=
# Which customer sign-in methods are on. Leave empty for phone,google. Used by customer-api, and
# every API refuses a value it does not know.
SIGNIN_METHODS=
# customer-api only. Public, and separated by commas: the web client, then the iOS client when it exists.
GOOGLE_CLIENT_IDS=144794375699-vdlaflhhjmpfgdv8qscjlncp2909ea1l.apps.googleusercontent.com
JWT_REFRESH_TTL_SECONDS=7776000
OTP_TEST_MODE=true            # Production refuses true, and no service starts with false until an SMS provider is built, so production cannot start yet
CONSOLE_TOTP=                 # console-api: required (default, and always in production) or optional (staging until pre-launch)
OTP_TEST_CODE=                # Six digits. Required while OTP_TEST_MODE is true

# --- Razorpay (test keys until go-live) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Firebase Cloud Messaging ---
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=     # Path to the JSON file, kept outside the repo

# --- SMS gateway ---
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_DLT_ENTITY_ID=

# --- Masked calls ---
TELEPHONY_PROVIDER=
TELEPHONY_API_KEY=
TELEPHONY_API_SECRET=

# --- Maps and routing ---
GOOGLE_MAPS_SERVER_API_KEY=   # Server key, restricted by API and IP
ROUTING_ENGINE_URL=           # OSRM or Valhalla, if chosen

# --- Observability ---
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
