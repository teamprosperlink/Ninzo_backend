# Copy to .env for local work: cp env.example .env
# Never commit .env. Never paste real secrets into chat or Issues.
# Order timer values (timer length, zone radius and so on) are NOT here. They are console settings stored in the database.

# --- App ---
APP_ENV=local                 # local | staging | production
LOG_LEVEL=debug
HTTP_PORT=8080

# --- Postgres ---
# Local: Docker Postgres from deploy/compose.yml. Staging and production: Supabase session pooler string from the dashboard.
DATABASE_URL=postgres://ninzo:ninzo_local@localhost:5432/ninzo?sslmode=disable
DB_MAX_CONNS=5                # Keep small: all services together must stay under the plan's connection limit

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
JWT_SIGNING_KEY=              # Generate a long random value per environment
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
TIMESTAMP_SIGNING_KEY=        # Signs server timestamps sent to devices
OTP_TEST_MODE=true            # Must be false in production. Test OTP is used until DLT registration is done
OTP_TEST_CODE=

# --- Razorpay (test keys until go-live) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Firebase Cloud Messaging ---
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=     # Path to the JSON file, kept outside the repo

# --- SMS gateway ---
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_DLT_ENTITY_ID=

# --- Masked calls ---
TELEPHONY_PROVIDER=
TELEPHONY_API_KEY=
TELEPHONY_API_SECRET=

# --- Maps and routing ---
GOOGLE_MAPS_SERVER_API_KEY=   # Server key, restricted by API and IP
ROUTING_ENGINE_URL=           # OSRM or Valhalla, if chosen

# --- Observability ---
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
